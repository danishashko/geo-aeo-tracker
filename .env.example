# ============================================================================
# geo-aeo-tracker — environment template
# Copy to `.env` and fill in what you want:  cp .env.example .env
#
# EVERY variable in this file is optional. The app builds, boots, and deploys
# with an empty .env — you just get the demo dataset instead of live data.
# Add keys to switch features on one at a time; nothing else breaks when one
# is missing.
# ============================================================================

# ----------------------------------------------------------------------------
# Bright Data API key — unlocks live AI-engine tracking
# Account settings -> API keys. Without it the dashboard runs on demo data.
# ----------------------------------------------------------------------------
BRIGHT_DATA_KEY=

# ----------------------------------------------------------------------------
# OpenRouter key — unlocks the analysis layer (visibility scoring, SRO,
# site context, battlecards). Without it, scraping still works and the
# analysis panels show an "not configured" notice instead of numbers.
# ----------------------------------------------------------------------------
OPENROUTER_KEY=

# Override the analysis model. Default: google/gemini-3.5-flash
# OPENROUTER_MODEL=google/gemini-3.5-flash

# ----------------------------------------------------------------------------
# Rank Signal (SRO tab, paired A/B feature tests). All optional.
#   RANK_SIGNAL_JUDGE_MODEL     judge that picks A or B
#   RANK_SIGNAL_REWRITE_MODEL   builds the with/without pairs
#                               (default: OPENROUTER_MODEL, then gemini-3.5-flash)
#   RANK_SIGNAL_ALLOWED_MODELS  comma list the route may use (default: the two
#                               defaults below); each also needs a price entry
#                               in lib/server/rank-signal-judge.ts
#   RANK_SIGNAL_MAX_USD_PER_HOUR  server-side spend cap per instance (in-memory)
# ----------------------------------------------------------------------------
# RANK_SIGNAL_JUDGE_MODEL=google/gemini-3.6-flash
# RANK_SIGNAL_REWRITE_MODEL=google/gemini-3.5-flash
# RANK_SIGNAL_ALLOWED_MODELS=google/gemini-3.6-flash,google/gemini-3.5-flash
# RANK_SIGNAL_MAX_USD_PER_HOUR=10

# ----------------------------------------------------------------------------
# Google Gemini API key — powers only the SRO "grounding" stage, which uses
# Google Search grounding to see which pages Gemini cites in real time.
# OpenRouter cannot do that, which is why this is separate. Missing key just
# skips that one stage; the rest of the SRO pipeline runs.
# ----------------------------------------------------------------------------
GEMINI_API_KEY=

# ----------------------------------------------------------------------------
# Bright Data zone names. Defaults match the names Bright Data's own docs use,
# so most accounts work without setting these. Set them if you named your
# zones differently.
#   SERP API zone      -> default "serp_api1"
#   Web Unlocker zone  -> default "web_unlocker1"
# ----------------------------------------------------------------------------
# BRIGHT_DATA_SERP_ZONE=serp_api1
# BRIGHT_DATA_UNLOCKER_ZONE=web_unlocker1

# ----------------------------------------------------------------------------
# AI Scraper dataset IDs. The app ships with Bright Data's public dataset ID
# for every engine, so you do NOT need to set these. Override only if you are
# on a custom or private dataset.
#   ChatGPT      gd_m7aof0k82r803d5bjm
#   Perplexity   gd_m7dhdot1vw9a7gc1n
#   Copilot      gd_m7di5jy6s9geokz8w
#   Gemini       gd_mbz66arm2mf9cu856y
#   Google AI    gd_mcswdt6z2elth3zqr2
# ----------------------------------------------------------------------------
# BRIGHT_DATA_DATASET_CHATGPT=
# BRIGHT_DATA_DATASET_PERPLEXITY=
# BRIGHT_DATA_DATASET_COPILOT=
# BRIGHT_DATA_DATASET_GEMINI=
# BRIGHT_DATA_DATASET_GOOGLE_AI=

# ----------------------------------------------------------------------------
# Supabase cloud sync. State lives in the browser by default; set these only
# if you want cross-device sync.
# ----------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# NEXT_PUBLIC_CLOUD_STORAGE_ENABLED=true
# Shared secret gating cloud writes; enter the same value once in the UI.
# STATE_SYNC_SECRET=your_long_random_secret

# ----------------------------------------------------------------------------
# Deploy a read-only public preview: sample data, no keys, no API calls.
# ----------------------------------------------------------------------------
# NEXT_PUBLIC_DEMO_ONLY=true
